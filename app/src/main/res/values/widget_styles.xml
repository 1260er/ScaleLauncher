<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="UiScreenTitle">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="UiSectionTitle">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="UiBodyText">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="UiPrimaryButton">
        <item name="android:background">@drawable/ui_button_background</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="UiInput">
        <item name="android:background">@drawable/ui_input_background</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textColorHint">@color/ui_text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="UiCheckBox">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
    </style>

    <style name="UiRadioButton" parent="UiCheckBox" />
</resources>
