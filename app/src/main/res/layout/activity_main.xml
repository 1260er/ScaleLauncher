<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ScaleLauncher"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ordnet S400-Messungen anhand des Gewichts automatisch openScale-Benutzern zu. Unsichere Messungen bleiben gespeichert, bis ein Benutzer ausgewählt wurde." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Bluetooth-Adresse der Waage" />

        <EditText
            android:id="@+id/macAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AA:BB:CC:DD:EE:FF"
            android:inputType="textCapCharacters"
            android:maxLines="1" />

        <Button
            android:id="@+id/scanDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waage suchen und auswählen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="S400 Bind-Key (32 Hex-Zeichen)" />

        <EditText
            android:id="@+id/bindKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="00112233445566778899aabbccddeeff"
            android:inputType="textNoSuggestions"
            android:maxLength="32"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Benutzerprofile"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/openScaleUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/loadOpenScaleUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="openScale-Zugriff erlauben und Benutzer laden" />

        <TextView
            android:id="@+id/openScaleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="openScale: noch nicht geprüft" />

        <CheckBox
            android:id="@+id/profileEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Diesen Benutzer automatisch zuordnen" />

        <EditText
            android:id="@+id/birthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:hint="Geburtstag auswählen"
            android:inputType="none"
            android:maxLines="1" />

        <EditText
            android:id="@+id/heightCm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Größe in cm"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <RadioGroup
            android:id="@+id/sexGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/sexFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weiblich" />
            <RadioButton
                android:id="@+id/sexMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Männlich" />
        </RadioGroup>

        <EditText
            android:id="@+id/referenceWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Referenzgewicht in kg"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/weightTolerance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zulässige Abweichung in kg, z. B. 3,0"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/healthConnectProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health Connect nur für diesen Benutzer verwenden" />

        <Button
            android:id="@+id/saveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dieses Benutzerprofil speichern" />

        <TextView
            android:id="@+id/profileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Noch kein Profil ausgewählt" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Das Referenzgewicht wird beim Laden aus den letzten fünf openScale-Messungen vorgeschlagen. Nach jeder eindeutig zugeordneten Messung wird es automatisch aktualisiert. Bei weniger als 1 kg Vorsprung zum zweitbesten Profil wird nicht geraten." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nicht zugeordnete Messungen"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pendingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine offene Messung" />

        <Spinner
            android:id="@+id/pendingUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/assignPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zuordnen" />
            <Button
                android:id="@+id/discardPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Verwerfen" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Health Connect"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/healthConnectEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messungen des festgelegten Hauptbenutzers nach Health Connect schreiben" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Zu übertragende Werte auswählen:" />

        <CheckBox android:id="@+id/hcWeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gewicht" />
        <CheckBox android:id="@+id/hcBodyFat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Körperfett" />
        <CheckBox android:id="@+id/hcBodyWater" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Körperwassermasse" />
        <CheckBox android:id="@+id/hcBoneMass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Knochenmasse" />
        <CheckBox android:id="@+id/hcLeanBodyMass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fettfreie Masse" />
        <CheckBox android:id="@+id/hcBmr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grundumsatz" />
        <CheckBox android:id="@+id/hcBmi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BMI ermöglichen (Gewicht + Größe übertragen)" />

        <Button
            android:id="@+id/connectHealthConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schreibrechte für ausgewählte Werte erlauben" />

        <TextView
            android:id="@+id/healthConnectStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health Connect: noch nicht geprüft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Zuverlässiger Hintergrundbetrieb"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/systemRequirementsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Systemfreigaben werden geprüft …" />

        <Button
            android:id="@+id/batteryOptimizationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Akkuoptimierung ausschalten / uneingeschränkt" />

        <Button
            android:id="@+id/unusedAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verwaltung bei Nichtnutzung deaktivieren" />

        <CheckBox
            android:id="@+id/autoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nach Neustart automatisch starten" />

        <Button
            android:id="@+id/saveStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfiguration speichern und Überwachung starten" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Überwachung stoppen" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status wird geprüft …"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notificationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Benachrichtigungseinstellungen öffnen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ereignisprotokoll"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/diagnosticLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnoseprotokoll aktivieren (detaillierte Messwerte und Zuordnungsgründe)" />

        <TextView
            android:id="@+id/logInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Im Normalmodus werden nur wichtige Statusmeldungen, erfolgreiche Übergaben und Fehler gespeichert. Alte Einträge werden automatisch gelöscht." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/refreshLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aktualisieren" />
            <Button android:id="@+id/copyLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kopieren" />
            <Button android:id="@+id/clearLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Leeren" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:minHeight="180dp"
            android:padding="10dp"
            android:text="Noch kein Ereignis" />
    </LinearLayout>
</ScrollView>
