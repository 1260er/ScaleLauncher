<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/pageHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonOpenMenu"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_menu" />

            <TextView
                style="@style/UiScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/app_name"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/scaleStatusImage"
                android:layout_width="112dp"
                android:layout_height="134dp"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:adjustViewBounds="true"
                android:contentDescription="@string/status_scale_disconnected"
                android:scaleType="fitCenter"
                android:src="@drawable/scale_disconnected" />

            <TextView
                android:id="@+id/status"
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_waiting_for_measurement" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ordnet S400-Messungen anhand des Gewichts automatisch openScale-Benutzern zu. Unsichere Messungen bleiben gespeichert, bis ein Benutzer ausgewählt wurde." />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Das Referenzgewicht wird beim Laden aus den letzten fünf openScale-Messungen vorgeschlagen. Nach jeder eindeutig zugeordneten Messung wird es automatisch aktualisiert. Bei weniger als 1 kg Vorsprung zum zweitbesten Profil wird nicht geraten." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nicht zugeordnete Messungen"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pendingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine offene Messung" />

        <Spinner
            android:id="@+id/pendingUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/assignPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zuordnen" />
            <Button
                android:id="@+id/discardPending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Verwerfen" />
        </LinearLayout>







        <Button
            android:id="@+id/saveStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfiguration speichern und Überwachung starten" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Überwachung stoppen" />




        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ereignisprotokoll"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/diagnosticLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagnoseprotokoll aktivieren (detaillierte Messwerte und Zuordnungsgründe)" />

        <TextView
            android:id="@+id/logInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Im Normalmodus werden nur wichtige Statusmeldungen, erfolgreiche Übergaben und Fehler gespeichert. Alte Einträge werden automatisch gelöscht." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/refreshLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aktualisieren" />
            <Button android:id="@+id/copyLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kopieren" />
            <Button android:id="@+id/clearLog" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Leeren" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:minHeight="180dp"
            android:padding="10dp"
            android:text="Noch kein Ereignis" />
    </LinearLayout>
</ScrollView>

        <include
            layout="@layout/page_scale"
            android:visibility="gone" />

        <include
            layout="@layout/page_permissions"
            android:visibility="gone" />
        <include
            layout="@layout/page_users"
            android:visibility="gone" />


        <include
            layout="@layout/page_user_detail"
            android:visibility="gone" />

        <include
            layout="@layout/page_health_connect"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_navigation_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
