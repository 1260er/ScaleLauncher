<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/pageHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/screen_padding_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/UiScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonOpenMenu"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_open_menu"
                    android:padding="@dimen/spacing_sm"
                    android:src="@drawable/ic_menu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/scaleStatusImage"
                    android:layout_width="112dp"
                    android:layout_height="134dp"
                    android:layout_marginEnd="@dimen/spacing_xl"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/status_scale_disconnected"
                    android:scaleType="fitCenter"
                    android:src="@drawable/scale_disconnected" />

                <TextView
                    android:id="@+id/status"
                    style="@style/UiBodyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_waiting_for_measurement"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeUsersSummary"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/home_users_loading" />

            <TextView
                android:id="@+id/homeUsersList"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/homePeerSyncStatus"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md" />

            <TextView
                android:id="@+id/homeHealthConnectState"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/home_health_connect_disabled" />

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/home_health_connect_user_title" />

            <TextView
                android:id="@+id/homeHealthConnectUser"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_health_connect_user_none" />

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/pending_measurements_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pendingStatus"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pending_none" />

            <Spinner
                android:id="@+id/pendingUser"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/ui_spinner_background"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="56dp"
                android:spinnerMode="dropdown"
                android:textAlignment="viewStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/assignPending"
                    style="@style/UiPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_assign" />

                <Button
                    android:id="@+id/rejectPending"
                    style="@style/UiPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/action_not_my_measurement" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveStart"
                    style="@style/UiPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_save_start" />

                <Button
                    android:id="@+id/stop"
                    style="@style/UiPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/action_stop_monitoring" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <include
            layout="@layout/page_scale"
            android:visibility="gone" />

        <include
            layout="@layout/page_permissions"
            android:visibility="gone" />
        <include
            layout="@layout/page_users"
            android:visibility="gone" />


        <include
            layout="@layout/page_user_detail"
            android:visibility="gone" />

        <include
            layout="@layout/page_health_connect"
            android:visibility="gone" />

        <include
            layout="@layout/page_emergency_cleanup"
            android:visibility="gone" />

        <include
            layout="@layout/page_log"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_navigation_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
