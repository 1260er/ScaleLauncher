<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageUserDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/userDetailTitle"
                style="@style/UiScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_users_title" />

            <ImageButton
                android:id="@+id/saveProfile"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_save"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_save" />
        </LinearLayout>

        <Spinner
            android:id="@+id/openScaleUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/profileEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/sexGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/sexMale"
                style="@style/UiRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ui_text_primary"
                android:text="@string/user_sex_male" />

            <RadioButton
                android:id="@+id/sexFemale"
                style="@style/UiRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:buttonTint="@color/ui_text_primary"
                android:text="@string/user_sex_female" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_birth_date_hint" />

            <EditText
                android:id="@+id/birthDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="false"
                android:gravity="end|center_vertical"
                android:hint="@string/user_birth_date_example"
                android:inputType="none"
                android:maxLines="1"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_height_hint" />

            <EditText
                android:id="@+id/heightCm"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="end|center_vertical"
                android:hint="@string/user_height_example"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_reference_weight_hint" />

            <EditText
                android:id="@+id/referenceWeight"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="end|center_vertical"
                android:hint="@string/user_reference_weight_example"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_weight_tolerance_hint" />

            <EditText
                android:id="@+id/weightTolerance"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="end|center_vertical"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_owner_device" />

            <Spinner
                android:id="@+id/ownerDevice"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/healthConnectProfile"
            style="@style/UiCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:buttonTint="@color/ui_text_primary"
            android:gravity="center_vertical"
            android:text="@string/user_health_connect" />

        <TextView
            android:id="@+id/profileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
